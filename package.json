{
  "name": "maid",
  "productName": "MAID",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "app": "ELECTRON_EXEC_PATH=node_modules/electron/dist/MAID.app/Contents/MacOS/Electron electron-vite dev",
    "web": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && electron-vite build",
    "start": "ELECTRON_EXEC_PATH=node_modules/electron/dist/MAID.app/Contents/MacOS/Electron electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/brand-electron.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "decode-named-character-reference": "^1.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-vite": "^6.0.0",
